<div class="employee-list-container">
  <!-- 頁面標題 -->
  <div class="page-header">
    <h1>員工管理</h1>
    <div class="header-actions">
      <a routerLink="/employees/new" class="btn btn-primary">
        <i class="icon-plus"></i>
        新增員工
      </a>
    </div>
  </div>

  <!-- 搜尋區域 -->
  <div class="search-section">
    <form [formGroup]="searchForm" (ngSubmit)="searchEmployees()" class="search-form">
      <div class="form-row">
        <div class="form-group">
          <label for="name">員工姓名</label>
          <input 
            type="text" 
            id="name" 
            formControlName="name" 
            placeholder="請輸入員工姓名"
            class="form-control"
          >
        </div>
        
        <div class="form-group">
          <label for="departmentId">部門</label>
          <select 
            id="departmentId" 
            formControlName="departmentId" 
            class="form-control"
          >
            <option value="">請選擇部門</option>
            @for (department of departments(); track department.id) {
              <option [value]="department.id">{{ department.name }}</option>
            }
          </select>
        </div>
        
        <div class="form-actions">
          <button type="submit" class="btn btn-primary" [disabled]="loading()">
            @if (loading()) {
              <span class="loading-spinner"></span>
            }
            搜尋
          </button>
          <button type="button" class="btn btn-secondary" (click)="resetSearch()">
            重設
          </button>
        </div>
      </div>
    </form>
  </div>

  <!-- 載入狀態 -->
  @if (loading()) {
    <div class="loading-overlay">
      <div class="loading-spinner-large"></div>
      <p>載入中...</p>
    </div>
  } @else {
    <!-- 員工列表 -->
    <div class="results-section">
      <div class="results-header">
        <span class="results-count">
          共找到 {{ totalRecords() }} 筆資料
        </span>
      </div>

      @if (employees().length === 0) {
        <div class="empty-state">
          <div class="empty-icon">👥</div>
          <h3>沒有找到員工資料</h3>
          <p>請調整搜尋條件或新增員工</p>
          <a routerLink="/employees/new" class="btn btn-primary">
            新增第一個員工
          </a>
        </div>
      } @else {
        <div class="employee-table-container">
          <table class="employee-table">
            <thead>
              <tr>
                <th>員工編號</th>
                <th>姓名</th>
                <th>部門</th>
                <th class="actions-column">操作</th>
              </tr>
            </thead>
            <tbody>
              @for (employee of employees(); track employee.id) {
                <tr>
                  <td>{{ employee.id }}</td>
                  <td>{{ employee.name }}</td>
                  <td>{{ getDepartmentName(employee.departmentId) }}</td>
                  <td class="actions-cell">
                    <div class="action-buttons">
                      <a 
                        [routerLink]="['/employees', employee.id]" 
                        class="btn btn-sm btn-outline"
                        title="檢視詳細資訊"
                      >
                        檢視
                      </a>
                      <a 
                        [routerLink]="['/employees', employee.id, 'edit']" 
                        class="btn btn-sm btn-outline"
                        title="編輯員工資訊"
                      >
                        編輯
                      </a>
                      <button 
                        type="button"
                        class="btn btn-sm btn-danger"
                        (click)="deleteEmployee(employee)"
                        title="刪除員工"
                        [disabled]="loading()"
                      >
                        刪除
                      </button>
                    </div>
                  </td>
                </tr>
              }
            </tbody>
          </table>
        </div>

        <!-- 分頁控制項 -->
        @if (totalPages() > 1) {
          <div class="pagination-container">
            <div class="pagination-info">
              第 {{ currentPage() }} 頁，共 {{ totalPages() }} 頁
            </div>
            <div class="pagination-controls">
              <button 
                type="button"
                class="btn btn-sm btn-outline"
                [disabled]="!hasPreviousPage() || loading()"
                (click)="previousPage()"
              >
                上一頁
              </button>
              
              @for (pageNum of visiblePages(); track pageNum) {
                <button 
                  type="button"
                  class="btn btn-sm"
                  [class.btn-primary]="pageNum === currentPage()"
                  [class.btn-outline]="pageNum !== currentPage()"
                  [disabled]="loading()"
                  (click)="goToPage(pageNum)"
                >
                  {{ pageNum }}
                </button>
              }
              
              <button 
                type="button"
                class="btn btn-sm btn-outline"
                [disabled]="!hasNextPage() || loading()"
                (click)="nextPage()"
              >
                下一頁
              </button>
            </div>
          </div>
        }
      }
    </div>
  }
</div>
